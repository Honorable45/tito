# Seules les variables utiles sont listées ; les autres ont une valeur par défaut (voir README).

# ─── Base de données
# Développement : `pnpm db:start` crée une base locale sur le port 5436 (distincte de TH Store).
DATABASE_URL="postgresql://titotrade@localhost:5436/titotrade?schema=public"

# ─── Adresses (sans / final)
# Prod : ex. https://titotrade.vercel.app, https://titotrade-admin.vercel.app, https://titotrade-api.onrender.com
WEB_ORIGIN="http://localhost:3000"
ADMIN_ORIGIN="http://localhost:3001"
API_PUBLIC_URL="http://localhost:4000"

# ─── Secrets
# APP_SECRET : openssl rand -base64 48 — signe sessions, codes d'avis, IMEI.
APP_SECRET="change-me-with-a-long-random-value"
# DATA_ENCRYPTION_KEY : openssl rand -base64 32 — chiffre les IMEI. Ne jamais la changer.
DATA_ENCRYPTION_KEY="base64-32-bytes"

# ─── Premier compte Responsable (utilisé uniquement par `pnpm db:seed`)
SEED_MANAGER_EMAIL="responsable@example.com"
SEED_MANAGER_NAME="Responsable"
SEED_MANAGER_PASSWORD=""

# ─── Production uniquement (déjà réglées dans render.yaml)
# NODE_ENV=production
# COOKIE_SECURE=true
# TRUST_PROXY=2

# ─── Photos : Cloudinary (obligatoire en production, sinon les photos sont perdues à chaque déploiement)
# Tableau de bord Cloudinary → API Keys → « API environment variable ». Vide = photos sur le disque (développement).
# CLOUDINARY_URL="cloudinary://CLE_API:SECRET_API@NOM_DU_CLOUD"
# Nouveau (TitoTrade) : dossier racine des photos dans le compte Cloudinary (« titotrade » par défaut).
# CLOUDINARY_FOLDER="titotrade"

# ─── Facultatif : paiement TMoney / Flooz en ligne (PayGate Global)
# PAYGATE_API_KEY=""
